# https://hub.docker.com/r/linuxserver/mastodon#application-setup
SECRET_KEY_BASE=
OTP_SECRET=

# https://hub.docker.com/r/linuxserver/mastodon#application-setup
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

SMTP_SERVER=mail.example.com
SMTP_PORT=25
SMTP_LOGIN=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=notifications@example.com

WEB_DOMAIN=mastodon.example.com #optional

ES_ENABLED=true
ES_HOST=elasticsearch
ES_PORT=9200
ES_USER=elastic
ES_PASS=<SUPER_SECURE_PASSWORD>

